generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(uuid())
  name            String
  walletAddress   String            @unique
  vaultContractId String?           @unique
  vaultWasmHash   String?
  vaultSalt       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  budgetPlans     BudgetPlan[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  transactions    Transaction[]
  vaults          Vault[]
  wallets         WalletConnection?
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalletConnection {
  id        String     @id @default(uuid())
  userId    String     @unique
  walletId  WalletType
  address   String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BudgetPlan {
  id          String   @id @default(uuid())
  userId      String
  category    String
  name        String
  amount      Decimal  @db.Decimal(18, 7)
  unlockDay   Int?
  planType    PlanType @default(BILL)
  description String?
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaults      Vault[]

  @@index([userId, active])
}

model Vault {
  id               String      @id @default(uuid())
  userId           String
  budgetPlanId     String?
  category         String
  name             String
  amount           Decimal     @db.Decimal(18, 7)
  status           VaultStatus @default(LOCKED)
  unlockDate       DateTime?
  planType         PlanType    @default(BILL)
  contractId       String
  contractPlanId   Int
  releasedAt       DateTime?
  earlyWithdrawnAt DateTime?
  releaseTxHash    String?
  breakTxHash      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  budgetPlan       BudgetPlan? @relation(fields: [budgetPlanId], references: [id])
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([unlockDate])
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  wallet      String
  amount      Decimal         @db.Decimal(18, 7)
  type        TransactionType
  description String?
  txHash      String?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

enum PlanType {
  BILL
  EMERGENCY
  SAVINGS
}

enum VaultStatus {
  LOCKED
  RELEASED
  EARLY_WITHDRAWN
}

enum TransactionType {
  SALARY_DEPOSIT
  ALLOCATION
  RELEASE
  EARLY_WITHDRAWAL
  DEPOSIT
}

enum WalletType {
  FREIGHTER
  ALBEDO
  XBULL
  RABET
  LOBSTR
  WALLETCONNECT
  HANA
  UNKNOWN
}
