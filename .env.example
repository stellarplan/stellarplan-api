# StellarPlan API — environment variables
# Copy to .env and fill in your values.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stellarplan?schema=public"

# JWT secrets (required)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="15m"

# Server (optional)
PORT="4000"
CORS_ORIGIN="http://localhost:3000"

# Stellar (optional — omit to run fully off-chain for demos)
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# Backend service keypair that signs vault-contract invocations.
# Get a funded testnet account: https://laboratory.stellar.org/#account-creator?network=test
STELLAR_SECRET_KEY=""

# Default USDC testnet token contract (override if you deploy your own)
USDC_TOKEN_CONTRACT=""
