# StellarPlan API — environment variables
# Copy to .env and fill in your values.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stellarplan?schema=public"

# JWT secrets (required)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="15m"

# Server (optional)
PORT="4000"
CORS_ORIGIN="http://localhost:3000"

# Stellar network endpoints (safe defaults for testnet)
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# On-chain vault operations (REQUIRED for allocations, releases, and early breaks).
# Without these, salary detection still works but locking funds fails loudly
# rather than recording an unfunded vault. Read-only balance/payment queries
# always work regardless.
#
# Backend service keypair that signs vault-contract invocations.
# Get a funded testnet account: https://laboratory.stellar.org/#account-creator?network=test
STELLAR_SECRET_KEY=""

# Fallback PlanVault contract id, used when a user has no per-wallet contract yet.
VAULT_CONTRACT_ID=""

# USDC token contract id for the asset held in vaults.
USDC_TOKEN_CONTRACT=""
